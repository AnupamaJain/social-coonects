# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Local development uses SQLite and needs no setup.
# In production set a Postgres URL and the schema + driver switch automatically.
#   DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# Public origin. Used to build OAuth redirect URLs and Stripe return URLs.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL if unset.
APP_URL="http://localhost:3000"

# Encrypts OAuth access tokens at rest (AES-256-GCM).
# REQUIRED IN PRODUCTION — the app refuses to start without it.
# Generate with: openssl rand -base64 32
# Locally, a fixed development key is used if this is unset.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# AI — optional. Without one of these the app runs in offline mode: scoring and
# the Voice Fingerprint work fully; generation falls back to a template writer.
# ---------------------------------------------------------------------------

# Preferred: one key, every provider, with observability and fallbacks.
AI_GATEWAY_API_KEY=""

# Or talk to Anthropic directly.
ANTHROPIC_API_KEY=""

# Override the default model (anthropic/claude-sonnet-5).
# AI_MODEL="anthropic/claude-sonnet-5"

# ---------------------------------------------------------------------------
# Billing — optional. Without these the billing page explains what's missing
# and the app stays on the free plan.
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=""       # sk_test_...
STRIPE_PRICE_ID=""         # price_... for your recurring Pro price
STRIPE_WEBHOOK_SECRET=""   # whsec_... from `stripe listen`

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------

# Required in production: cron routes reject requests without this bearer token.
# Vercel Cron sends it automatically once the variable exists on the project.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Social platforms — all optional. Any platform without credentials can still
# be connected as a sandbox account, which exercises the entire product
# (composing, scheduling, publishing, analytics) without leaving your machine.
#
# Redirect URL for each: {APP_URL}/api/oauth/{platform}/callback
# ---------------------------------------------------------------------------

# X — https://developer.x.com/en/portal/dashboard (OAuth 2.0, PKCE)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# LinkedIn — https://www.linkedin.com/developers/apps
# Needs the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Instagram + Facebook — https://developers.facebook.com/apps (one Meta app covers both)
# Instagram publishing requires a Business account linked to a Facebook Page.
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# Threads — https://developers.facebook.com/docs/threads
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""

# Mastodon — create an app in your instance's Preferences > Development
MASTODON_INSTANCE="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
